FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# Dependency layer: only lock + manifests, so source edits don't bust the cache
COPY pyproject.toml uv.lock .python-version ./
COPY api/pyproject.toml api/README.md ./api/
COPY engine/pyproject.toml engine/README.md ./engine/
RUN uv sync --frozen --no-dev --no-install-workspace

# Project layer
COPY api/ ./api/
COPY engine/ ./engine/
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"
VOLUME /data
ENV DATABASE_URL=sqlite:////data/site.db

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
