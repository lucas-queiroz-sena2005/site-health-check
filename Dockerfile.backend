FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir poetry==1.8.3

COPY api/pyproject.toml api/poetry.lock* api/README.md* ./api/
COPY engine/pyproject.toml engine/poetry.lock* engine/README.md* ./engine/

RUN poetry config virtualenvs.create false
RUN mkdir -p ./engine/src/engine ./api/src/api && touch ./engine/src/engine/__init__.py ./api/src/api/__init__.py

WORKDIR /app/api
RUN poetry lock --no-update && poetry install --no-root --no-interaction --no-ansi --only main 

WORKDIR /app/engine
RUN poetry lock --no-update && poetry install --no-root --no-interaction --no-ansi --only main 

WORKDIR /app
COPY api/ ./api/
COPY engine/ ./engine/

WORKDIR /app/api
RUN poetry lock --no-update && poetry install --no-interaction --no-ansi --only main 

WORKDIR /app/engine
RUN poetry lock --no-update && poetry install --no-interaction --no-ansi --only main 

WORKDIR /app
ENV PYTHONPATH=/app/api/src:/app/engine/src
VOLUME /data
ENV DATABASE_URL=sqlite:////data/site.db

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
