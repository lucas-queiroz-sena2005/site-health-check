# Environment Variables Template
# Copy this file to .env and fill in the values for your environment.

# Server Configuration
DOMAIN_NAME=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
TIMEZONE=UTC

# SSL Configuration
# Set ENABLE_SSL=true for production environments with a valid domain name.
# Set LOCAL_HTTPS=true to generate a local self-signed certificate and bypass Let's Encrypt Certbot.
# Set USE_STAGING_SSL=true to use Let's Encrypt staging servers for testing.
ENABLE_SSL=false
LOCAL_HTTPS=false
USE_STAGING_SSL=false
CERTBOT_EMAIL=admin@example.com
LOCAL_CA_DIR=

# IP Whitelist for Dashboard
# For public access, use: ALLOWED_IPS="allow all;"
# To restrict access, use: ALLOWED_IPS="allow 192.168.1.100; allow 203.0.113.50;"
ALLOWED_IPS="allow all;"

# Backend Configuration
DATABASE_URL=sqlite:////data/site.db
