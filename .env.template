# Environment Variables Template
# Copy this file to .env and fill in the values for your environment.

# Server Configuration
# DOMAIN_NAME controls the Nginx server_name directive. Use localhost for local dev.
DOMAIN_NAME=localhost

# SSL Configuration
# Set ENABLE_SSL=true for production environments with a valid domain name.
# Set ENABLE_SSL=false for local development or plain HTTP deployments.
ENABLE_SSL=false

# Let's Encrypt Configuration
# Required only if ENABLE_SSL=true
CERTBOT_EMAIL=admin@example.com
