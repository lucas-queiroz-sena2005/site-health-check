# Ignore Python compiled files and tool caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
src/.ruff_cache/

# Ignore output files and raw logs
/results*.json
/results/*.json
*.raw.log
conductor/**/*.html

# Ignore virtual environments if created manually
.venv/
venv/
env/
*.db
*.db-*

# Ignore environment variable files
.env
.env.*
!.env.template

# Ignore docker volumes
certbot/conf/
certbot/www/
